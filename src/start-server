#!/usr/bin/env python3

import os
import argparse
from lib.file_transfer_server import FileTransferServer
import lib.args_verifier as args_verifier
import logging


def main():
    parser = argparse.ArgumentParser(description="File Transfer Server")
    group = parser.add_mutually_exclusive_group()
    group.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="increase output verbosity")
    group.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="decrease output verbosity")
    parser.add_argument(
        "-H",
        "--host",
        type=str,
        default="127.0.0.1",
        help="IP al que se quiere conectar")
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=5005,
        help="Puerto al que se quiere conectar")
    parser.add_argument(
        "-s",
        "--storage",
        type=str,
        default="storage",
        help="Directorio donde guardar los archivos")

    args = parser.parse_args()

    if args.verbose:
        logging.basicConfig(
            level=logging.DEBUG,
            format="%(message)s"
        )
    elif args.quiet:
        logging.basicConfig(
            level=logging.ERROR,
            format="%(message)s"
        )
    else:
        logging.basicConfig(
            level=logging.INFO,
            format="%(message)s"
        )

    if not args_verifier.verify_server_args(args):
        return

    os.makedirs(args.storage, exist_ok=True)

    server = FileTransferServer(
        host=args.host,
        port=args.port,
        storage_dir=args.storage)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.stop()


if __name__ == "__main__":
    main()
