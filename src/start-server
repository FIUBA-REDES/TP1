#!/usr/bin/env python3
import argparse
import socket
from lib.protocol import Packet

def create_socket(host, port):
    
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind((host, port))
    sock.listen(5)
    return sock


