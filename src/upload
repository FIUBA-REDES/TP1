import argparse
from lib.file_transfer_client import FileTransferClient
import lib.args_verifier as args_verifier


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Increase output verbosity")
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="Decrease output verbosity")
    parser.add_argument("-H", "--host", type=str, help="Server IP address")
    parser.add_argument("-p", "--port", type=int, help="Server port")
    parser.add_argument("-s", "--src", type=str, help="Source file path")
    parser.add_argument("-n", "--name", type=str, help="Name file name")
    parser.add_argument(
        "-r",
        "--protocol",
        type=str,
        help="Protocol error recovery protocol")

    args = parser.parse_args()

    if args_verifier.verify_client_args(args) is False:
        return

    cliente = FileTransferClient(args.host, args.port)

    try:
        if not cliente.connect(args.name):
            return

        cliente.upload(args.src, args.name, args.protocol)
    finally:
        cliente.close()


if __name__ == "__main__":
    main()
