import argparse
from lib.file_transfer_client import FileTransferClient


def main():
    parser = argparse.ArgumentParser()

    parser.add_argument("-h", "--help", help = "Show this help message and exit")
    parser.add_argument("-v", "--verbose", action="store_true", help= "Increase output verbosity")
    parser.add_argument("-q", "--quiet", action="store_false", help= "Decrease output verbosity")
    parser.add_argument("-H", "--host", type=str, help="Server IP address")
    parser.add_argument("-p", "--port", type=int, help="Server port")
    parser.add_argument("-d", "--dst", type=str, help="Destination file path")
    parser.add_argument("-n", "--name", type=str, help="Name file name")
    parser.add_argument("-r", "--protocol", type=str, help="Protocol error recovery protocol")

    args = parser.parse_args()

    ip_servidor = args.host
    port_servidor = args.port
    dst_archivo = args.dst
    name_archivo = args.name
    protocolo = args.protocol
    #print(f"Conectando al servidor en la dirección: {ip_servidor} en el puerto {port_servidor}...")

    cliente = FileTransferClient(ip_servidor, port_servidor)
    cliente.connect()

    cliente.download(dst_archivo, name_archivo, protocolo)

if __name__ == "__main__":
    main()