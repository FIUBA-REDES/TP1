import argparse
from lib.file_transfer_client import FileTransferClient
import lib.args_verifier as args_verifier
import logging

def main():
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Increase output verbosity")
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_false",
        help="Decrease output verbosity")
    parser.add_argument("-H", "--host", type=str, help="Server IP address")
    parser.add_argument("-p", "--port", type=int, help="Server port")
    parser.add_argument("-d", "--dst", type=str, help="Destination file path")
    parser.add_argument("-n", "--name", type=str, help="Name file name")
    parser.add_argument(
        "-r",
        "--protocol",
        type=str,
        help="Protocol error recovery protocol")

    args = parser.parse_args()

    if args.verbose:
        logging.basicConfig(
            level=logging.DEBUG,
            format="%(message)s"
    )
    elif args.quiet:
        logging.basicConfig(
            level=logging.ERROR,
            format="%(message)s"
    )
    else:
        logging.basicConfig(
            level=logging.INFO,
            format="%(message)s"
    )

    if args_verifier.verify_client_args(args) is False:
        return

    cliente = FileTransferClient(args.host, args.port)
    try:
        cliente.download(args.dst, args.name, args.protocol)
    finally:
        cliente.close()


if __name__ == "__main__":
    main()
